# NexusAssess backend configuration TEMPLATE.
# Copy to backend/.env and fill in real values. backend/.env is git-ignored: NEVER commit it or paste its
# contents into chats / tickets. Commit only this example file.

# ---- environment -------------------------------------------------------------------------------------------
# development | production.  Production refuses to start while any unsafe setting below is left as in development.
APP_ENV=development

# ---- secrets (required in production; generated locally in development if missing) ------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Key for secrets stored in the database (the SMTP password):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# ---- database (Supabase: use the Session pooler string; URL-encode special characters in the password) ------
# postgresql+pg8000://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTH_DATABASE_URL=

# ---- Supabase Storage (candidate photos and government IDs) -----------------------------------------------
# Project URL from Settings > API, for example https://<project-ref>.supabase.co
# Not the dashboard address. Service role key stays on the server only. Never commit the real key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IDENTITY_BUCKET=identity

# ---- first System Admin ------------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
# Leave empty to get a random password printed ONCE in the server log (you must change it at first sign-in).
SEED_ADMIN_PASSWORD=

# ---- email gateway (can also be saved later in System Admin > Settings > Email, stored encrypted) ----------
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---- web / CORS --------------------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production: https only, e.g. FRONTEND_URL=https://assess.example.com  CORS_ORIGINS=https://assess.example.com
# ALLOWED_HOSTS=api.example.com
COOKIE_SECURE=false
# Only behind a reverse proxy you control that sets X-Forwarded-For:
TRUST_PROXY=false

# ---- development conveniences (must be off in production) -------------------------------------------------
DEV_EXPOSE_OTP=true

# ---- tuning (all optional) ---------------------------------------------------------------------------------
# Initial values; the System Admin can change most of them in Settings > Security.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# OTP_EXPIRE_MINUTES=10
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# RATE_LIMIT_AUTH_PER_MINUTE=20
# MAX_REQUEST_BYTES=1000000
# ENABLE_DOCS=true
