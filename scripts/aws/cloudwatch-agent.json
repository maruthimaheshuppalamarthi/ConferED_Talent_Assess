{
  "agent": {
    "region": "ap-south-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/confered/nginx",
            "log_stream_name": "access",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/confered/nginx",
            "log_stream_name": "error",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
